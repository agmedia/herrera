{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid">
    <div class="pull-right">
      <a href="{{ requests_url|e }}" class="btn btn-info" data-toggle="tooltip" title="{{ button_requests }}"><i class="fa fa-list"></i></a>
      <button type="submit" form="form-legal-return" class="btn btn-primary" data-toggle="tooltip" title="{{ button_save }}"><i class="fa fa-save"></i></button>
      <a href="{{ cancel|e }}" class="btn btn-default" data-toggle="tooltip" title="{{ button_cancel }}"><i class="fa fa-reply"></i></a>
    </div>
    <h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href|e }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
  </div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}
    <div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-cog"></i> {{ text_edit }}</h3></div>
      <div class="panel-body">
        <form action="{{ action|e }}" method="post" id="form-legal-return" class="form-horizontal">
          <div class="form-group"><label class="col-sm-3 control-label" for="input-status">{{ entry_status }}</label><div class="col-sm-9"><select name="module_legal_return_status" id="input-status" class="form-control"><option value="1"{% if module_legal_return_status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_legal_return_status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
          <div class="form-group"><label class="col-sm-3 control-label" for="input-header-status">{{ entry_header_status }}</label><div class="col-sm-9"><select name="module_legal_return_header_status" id="input-header-status" class="form-control"><option value="1"{% if module_legal_return_header_status %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not module_legal_return_header_status %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>
          <div class="form-group required{% if error_email %} has-error{% endif %}"><label class="col-sm-3 control-label" for="input-email">{{ entry_email }}</label><div class="col-sm-9"><input type="email" name="module_legal_return_email" value="{{ module_legal_return_email|e }}" id="input-email" class="form-control" />{% if error_email %}<div class="text-danger">{{ error_email }}</div>{% endif %}</div></div>
        </form>
        <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_preserve_notice }}</div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
