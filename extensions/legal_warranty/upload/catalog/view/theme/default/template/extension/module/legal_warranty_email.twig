<div style="margin:20px 0;padding:16px;border:2px solid #00b5cc;background:#f7f7f7;color:#222222">
  <h2 style="font-size:18px;margin:0 0 10px;color:#222222">{{ text_email_heading }}</h2>
  <p style="margin:0 0 12px">{{ text_email_intro }}</p>
  <p style="margin:0 0 12px"><a href="{{ asset_url|e }}" target="_blank" rel="noopener noreferrer"><img src="{{ asset_url|e }}" alt="{{ text_email_asset|e }}" width="600" style="display:block;width:100%;max-width:600px;height:auto;border:0"></a></p>
  <p style="margin:0"><a href="{{ asset_url|e }}">{{ text_email_asset }}</a> · <a href="{{ eu_url|e }}">{{ text_eu_information }}</a></p>
</div>
<div style="margin:20px 0;padding:14px;border:1px solid #ccc;background:#fafafa;color:#222">
  <h2 style="font-size:16px;margin:0 0 8px">{{ text_email_withdrawal_heading }}</h2>
  <p style="margin:0 0 8px">{{ text_email_withdrawal }}</p>
  <p style="margin:0"><a href="{{ return_url|e }}">{{ text_email_return_link }}</a></p>
</div>
