{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-legal-warranty" class="btn btn-primary" title="{{ button_save }}"><i class="fa fa-save"></i></button> <a href="{{ cancel|e }}" class="btn btn-default" title="{{ button_cancel }}"><i class="fa fa-reply"></i></a></div><h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href|e }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}{% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
    <div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-shield"></i> {{ text_edit }}</h3></div><div class="panel-body">
      <form action="{{ action|e }}" method="post" id="form-legal-warranty" class="form-horizontal">
        {% set fields = {'module_legal_warranty_status': entry_status, 'module_legal_warranty_header_status': entry_header_status, 'module_legal_warranty_checkout_status': entry_checkout_status, 'module_legal_warranty_email_status': entry_email_status} %}
        {% for field,label in fields %}<div class="form-group"><label class="col-sm-3 control-label" for="input-{{ field|e }}">{{ label }}</label><div class="col-sm-9"><select name="{{ field|e }}" id="input-{{ field|e }}" class="form-control"><option value="1"{% if attribute(_context, field) %} selected{% endif %}>{{ text_enabled }}</option><option value="0"{% if not attribute(_context, field) %} selected{% endif %}>{{ text_disabled }}</option></select></div></div>{% endfor %}
        <div class="form-group required{% if error_url %} has-error{% endif %}"><label class="col-sm-3 control-label" for="input-eu-url">{{ entry_eu_url }}</label><div class="col-sm-9"><input type="url" name="module_legal_warranty_eu_url" value="{{ module_legal_warranty_eu_url|e }}" id="input-eu-url" class="form-control" />{% if error_url %}<div class="text-danger">{{ error_url }}</div>{% endif %}</div></div>
      </form>
      <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_asset_notice }} <a href="{{ official_asset|e }}" target="_blank" rel="noopener">{{ text_open_asset }}</a></div>
    </div></div>
  </div>
</div>
{{ footer }}
