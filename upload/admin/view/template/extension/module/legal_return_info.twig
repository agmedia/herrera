{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-request" class="btn btn-primary" title="{{ button_save }}"><i class="fa fa-save"></i></button> <a href="{{ cancel|e }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div><h1>{{ text_request_details }} #{{ request.legal_return_id }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href|e }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}{% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
    <div class="row"><div class="col-md-8"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-file-text-o"></i> {{ text_request_details }}</h3></div><div class="panel-body table-responsive">
      <table class="table table-bordered"><tbody>
        <tr><th>{{ column_id }}</th><td>#{{ request.legal_return_id }}</td><th>{{ column_order_id }}</th><td>#{{ request.order_id }}</td></tr>
        <tr><th>{{ column_type }}</th><td colspan="3">{{ request.request_type_label }}</td></tr>
        <tr><th>{{ field_firstname }}</th><td>{{ request.firstname|e }}</td><th>{{ field_lastname }}</th><td>{{ request.lastname|e }}</td></tr>
        <tr><th>{{ column_email }}</th><td>{{ request.email|e }}</td><th>{{ field_telephone }}</th><td>{{ request.telephone|e }}</td></tr>
        <tr><th>{{ field_address }}</th><td colspan="3">{{ request.address|e|nl2br }}</td></tr>
        <tr><th>{{ field_received_date }}</th><td>{{ request.received_date|e }}</td><th>{{ field_iban }}</th><td>{{ request.iban|e }}</td></tr>
        <tr><th>{{ field_products }}</th><td colspan="3">{{ request.product_details|e|nl2br }}</td></tr>
        <tr><th>{{ field_reason }}</th><td colspan="3">{{ request.reason|e|nl2br }}</td></tr>
        <tr><th>{{ column_date_added }}</th><td>{{ request.date_added|e }}</td><th>{{ field_date_modified }}</th><td>{{ request.date_modified|e }}</td></tr>
        <tr><th>{{ field_ip }}</th><td colspan="3">{{ request.ip|e }}</td></tr>
      </tbody></table>
    </div></div></div>
    <div class="col-md-4"><div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ column_status }}</h3></div><div class="panel-body">
      <form action="{{ action|e }}" method="post" id="form-request"><div class="form-group"><label>{{ column_status }}</label><select name="status" class="form-control">{% for value,label in statuses %}<option value="{{ value|e }}"{% if value == request.status %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div><div class="form-group"><label>{{ entry_admin_note }}</label><textarea name="admin_note" rows="8" class="form-control">{{ request.admin_note|e }}</textarea></div></form>
    </div></div></div></div>
  </div>
</div>
{{ footer }}
