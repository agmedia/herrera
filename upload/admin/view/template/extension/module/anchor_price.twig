{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-anchor-price" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel|e }}" data-toggle="tooltip" title="{{ button_cancel|e }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href|e }}">{{ breadcrumb.text|e }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}
    {% if warning_customer_price %}
      <div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ warning_customer_price|e }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}
    {% if import_report %}
      <div class="alert alert-{{ import_report.success ? 'success' : 'danger' }}">
        <i class="fa fa-{{ import_report.success ? 'check-circle' : 'exclamation-circle' }}"></i> {{ import_report.message|e }}
        {% if import_report.errors %}
          <ul class="small" style="margin-top:8px;max-height:220px;overflow:auto;">
            {% for import_error in import_report.errors %}<li>{{ import_error|e }}</li>{% endfor %}
          </ul>
        {% endif %}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-anchor"></i> {{ text_edit }}</h3></div>
      <div class="panel-body">
        <form action="{{ action|e }}" method="post" enctype="multipart/form-data" id="form-anchor-price" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_anchor_price_status" id="input-status" class="form-control">
                <option value="1"{% if module_anchor_price_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_anchor_price_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-show-date">{{ entry_show_date }}</label>
            <div class="col-sm-10">
              <select name="module_anchor_price_show_date" id="input-show-date" class="form-control">
                <option value="1"{% if module_anchor_price_show_date %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_anchor_price_show_date %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
        </form>
        <div class="alert alert-info"><i class="fa fa-refresh"></i> {{ text_ocmod_notice }}</div>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-upload"></i> {{ text_import }}</h3></div>
      <div class="panel-body">
        <p>{{ text_import_help }}</p>
        <p class="text-muted"><i class="fa fa-database"></i> {{ text_import_scale_help }}</p>
        <p><code>{{ text_import_columns }}</code></p>
        <p><a href="{{ template_download|e }}" class="btn btn-default btn-sm"><i class="fa fa-download"></i> {{ text_download_template }}</a></p>
        <form action="{{ import_action|e }}" method="post" enctype="multipart/form-data" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-anchor-price-csv">{{ entry_csv }}</label>
            <div class="col-sm-8"><input type="file" name="anchor_price_csv" id="input-anchor-price-csv" accept=".csv,.txt,text/csv" class="form-control" required></div>
            <div class="col-sm-2"><button type="submit" class="btn btn-primary btn-block"><i class="fa fa-upload"></i> {{ button_import }}</button></div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
