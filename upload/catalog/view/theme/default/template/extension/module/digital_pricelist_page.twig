{{ header }}
<div id="digital-pricelist-page" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href|e }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}{% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}{% set class = 'col-sm-9' %}
    {% else %}{% set class = 'col-sm-12' %}{% endif %}
    <main id="content" class="{{ class }}">{{ content_top }}
      <header class="pricelist-heading">
        <h1>{{ heading_title }}</h1>
        <p class="lead">{{ text_intro }}</p>
        <p class="pricelist-update"><i class="fa fa-refresh" aria-hidden="true"></i> {{ text_updated_daily }}</p>
      </header>

      <div class="row pricelist-cards">
        <div class="col-sm-4">
          <section class="pricelist-card">
            <span class="pricelist-icon" aria-hidden="true"><i class="fa fa-code"></i></span>
            <h2>{{ text_xml_title }}</h2>
            <p>{{ text_xml_description }}</p>
            <a class="btn btn-pricelist" href="{{ xml_url|e }}" target="_blank" rel="noopener noreferrer"><i class="fa fa-external-link" aria-hidden="true"></i> {{ button_open_xml }}</a>
          </section>
        </div>
        <div class="col-sm-4">
          <section class="pricelist-card">
            <span class="pricelist-icon" aria-hidden="true"><i class="fa fa-table"></i></span>
            <h2>{{ text_csv_title }}</h2>
            <p>{{ text_csv_description }}</p>
            <a class="btn btn-pricelist" href="{{ csv_url|e }}" download><i class="fa fa-download" aria-hidden="true"></i> {{ button_download_csv }}</a>
          </section>
        </div>
        <div class="col-sm-4">
          <section class="pricelist-card">
            <span class="pricelist-icon" aria-hidden="true"><i class="fa fa-history"></i></span>
            <h2>{{ text_archive_title }}</h2>
            <p>{{ text_archive_description }}</p>
            <a class="btn btn-pricelist" href="#pricelist-archive"><i class="fa fa-folder-open" aria-hidden="true"></i> {{ button_view_archive }}</a>
          </section>
        </div>
      </div>

      <section id="pricelist-archive" class="pricelist-archive" aria-labelledby="pricelist-archive-title">
        <div class="pricelist-archive-header">
          <h2 id="pricelist-archive-title">{{ text_archive_heading }}</h2>
          <a href="{{ archives_api_url|e }}" target="_blank" rel="noopener noreferrer">{{ text_archive_api }} <i class="fa fa-external-link" aria-hidden="true"></i></a>
        </div>
        {% if archives %}
        <div class="table-responsive">
          <table class="table table-striped table-hover">
            <thead>
              <tr><th>{{ text_generated }}</th><th>{{ text_format }}</th><th>{{ text_size }}</th><th><span class="sr-only">{{ button_download_archive }}</span></th></tr>
            </thead>
            <tbody>
              {% for archive in archives %}
              <tr>
                <td>{{ archive.archived_at }}</td>
                <td><span class="label label-info">{{ archive.format }}</span></td>
                <td>{{ archive.size }}</td>
                <td class="text-right"><a class="btn btn-default btn-sm" href="{{ archive.url|e }}" download><i class="fa fa-download" aria-hidden="true"></i> {{ button_download_archive }}</a></td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <div class="alert alert-info"><i class="fa fa-info-circle" aria-hidden="true"></i> {{ text_archive_empty }}</div>
        {% endif %}
      </section>
      {{ content_bottom }}
    </main>
    {{ column_right }}
  </div>
</div>
<style>
#digital-pricelist-page{margin-bottom:45px}.pricelist-heading{max-width:900px;margin-bottom:28px}.pricelist-heading h1{margin-bottom:12px}.pricelist-update{padding:12px 15px;border-left:4px solid #00b5cc;background:#f2fbfc;color:#444}.pricelist-update .fa{color:#00a9c0;margin-right:7px}.pricelist-cards{display:flex;flex-wrap:wrap;margin-bottom:32px}.pricelist-cards>[class*="col-"]{display:flex}.pricelist-card{display:flex;flex:1;flex-direction:column;width:100%;margin-bottom:20px;padding:24px;border:1px solid #e2e5e7;border-top:4px solid #00b5cc;border-radius:3px;background:#fff;box-shadow:0 3px 12px rgba(0,0,0,.06)}.pricelist-card h2{margin:14px 0 10px;font-size:21px}.pricelist-card p{flex:1;margin-bottom:20px}.pricelist-icon{display:flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:50%;background:#e7f9fb;color:#00a9c0;font-size:20px}.btn-pricelist{align-self:flex-start;border-color:#00a9c0;background:#00b5cc;color:#fff}.btn-pricelist:hover,.btn-pricelist:focus{border-color:#008ea2;background:#009db2;color:#fff}.pricelist-archive{scroll-margin-top:20px}.pricelist-archive-header{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin-bottom:12px;border-bottom:1px solid #e4e4e4}.pricelist-archive-header h2{margin:0 0 12px}.pricelist-archive .table td{vertical-align:middle}.pricelist-archive .label-info{background:#00a9c0}@media(max-width:767px){.pricelist-cards{display:block}.pricelist-cards>[class*="col-"]{display:block}.pricelist-card{min-height:0}.btn-pricelist{display:block;width:100%;white-space:normal}.pricelist-archive-header{display:block;padding-bottom:12px}.pricelist-archive-header h2{margin-bottom:8px}.pricelist-archive .table{min-width:560px}}
</style>
{{ footer }}
